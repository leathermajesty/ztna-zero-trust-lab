# Copy this file to ".env" and fill in the values. The real .env is gitignored.
#   cp .env.example .env

# The DMZ IP of this Docker host. Used in the OIDC issuer and redirect URLs,
# so it must be an address the browser can actually reach.
HOST_IP=172.16.10.10

# PostgreSQL password (Keycloak's database). Pick anything.
DB_PASSWORD=change-me-db-password

# Keycloak bootstrap admin — only used on the very first start to create an admin.
# Log in once, create a proper named admin, then this can be removed/ignored.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-admin-password

# The Keycloak client secret for the confidential client "app-proxy".
# Keycloak generates it: Clients > app-proxy > Credentials > Client secret.
CLIENT_SECRET=paste-the-app-proxy-client-secret-here

# oauth2-proxy cookie secret. Generate a fresh one with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=paste-a-generated-32-byte-cookie-secret-here
